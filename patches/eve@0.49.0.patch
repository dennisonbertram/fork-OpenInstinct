+import type { AlsContext } from "#context/container.js";
+import { ContextKey } from "#context/key.js";
+import type { SessionStateMap } from "#harness/types.js";
+/**
+ * One settled background task owned by the active session, projected
+ * read-only from the parent's task index.
+ *
+ * `taskId` is the owning index entry; `terminalTaskId` and the child
+ * identifiers come from the cached terminal view, so a consumer can
+ * reject a terminal whose identity does not match its own task. The
+ * private `taskInboxToken` is never projected.
+ */
+export interface BackgroundTaskTerminal {
+    readonly taskId: string;
+    readonly terminalTaskId: string;
+    readonly parentTurnId: string;
+    readonly childSessionId?: string;
+    readonly childTurnId?: string;
+    readonly workerName: string;
+    readonly status: "completed" | "failed" | "cancelled";
+    readonly output?: unknown;
+}
+/**
+ * One background task owned by the active session, settled or not.
+ *
+ * Membership answers a different question from terminal evidence: a
+ * consumer deciding whether a whole cohort has finished must be able to
+ * see a task that is still running. A member record therefore carries no
+ * result, no child identity, and no `taskInboxToken` — only that the task
+ * exists and whether it has settled.
+ */
+export interface BackgroundTaskMember {
+    readonly taskId: string;
+    readonly parentTurnId: string;
+    readonly workerName: string;
+    readonly settled: boolean;
+}
+export declare const TaskTerminalsKey: ContextKey<readonly BackgroundTaskTerminal[]>;
+export declare const TaskMembersKey: ContextKey<readonly BackgroundTaskMember[]>;
+/** Projects every settled task in the index; pending tasks are omitted. */
+export declare function projectSessionTaskTerminals(state: SessionStateMap | undefined): readonly BackgroundTaskTerminal[];
+/** Projects every task in the index, settled or not. */
+export declare function projectSessionTaskMembers(state: SessionStateMap | undefined): readonly BackgroundTaskMember[];
+/** Refreshes both projections the active turn exposes to authored code. */
+export declare function setSessionTaskTerminals(context: AlsContext, state: SessionStateMap | undefined): void;
+/**
+ * Typed terminal results for background tasks owned by the active
+ * session. Requires an active eve context; returns an empty list when
+ * no task has settled.
+ */
+export declare function readBackgroundTaskTerminals(): readonly BackgroundTaskTerminal[];
+/**
+ * Every background task owned by the active session, settled or not.
+ * Requires an active eve context; returns an empty list when the session
+ * owns no task.
+ */
+export declare function readBackgroundTaskMembers(): readonly BackgroundTaskMember[];
